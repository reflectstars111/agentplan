  "multi_turn_scenarios": [
    {
      "scenario_id": "mt_001",
      "name": "Project Development Continuity",
      "description": "5-turn conversation simulating continuous project development",
      "turns": [
        {
          "turn": 1,
          "query": "Analyze the core architecture of the ARD system. What are its key components?",
          "expected_keywords": ["architecture", "store", "event", "retrieve", "mmu", "controller"],
          "state_to_carry": ["architecture_overview", "key_components"]
        },
        {
          "turn": 2,
          "query": "Based on the architecture from before, which component do you think is the most innovative and why?",
          "expected_keywords": ["innovative", "context", "mmu", "transaction", "reason"],
          "state_to_carry": ["innovation_analysis"],
          "requires_previous_turn": true
        },
        {
          "turn": 3,
          "query": "Now that we identified Context MMU as key, propose an improvement to its pipeline. What would you change?",
          "expected_keywords": ["improvement", "pipeline", "step", "filter", "compress", "budget"],
          "state_to_carry": ["improvement_proposal"],
          "requires_previous_turn": true
        },
        {
          "turn": 4,
          "query": "Given the improvement you proposed, how would it affect the Transaction Manager's writeback strategy?",
          "expected_keywords": ["transaction", "writeback", "affect", "consistency", "verify"],
          "state_to_carry": ["impact_analysis"],
          "requires_previous_turn": true
        },
        {
          "turn": 5,
          "query": "Summarize our entire discussion: the architecture, the innovation, the improvement, and the impact. What are the key decisions we made?",
          "expected_keywords": ["summary", "architecture", "innovation", "improvement", "decision", "impact"],
          "state_to_carry": ["final_summary"],
          "requires_previous_turn": true
        }
      ]
    },
    {
      "scenario_id": "mt_002",
      "name": "Research Paper Analysis Pipeline",
      "description": "5-turn deep analysis of a research direction",
      "turns": [
        {
          "turn": 1,
          "query": "What is the main research problem that ARD addresses? Frame it as a research question.",
          "expected_keywords": ["state", "management", "long-horizon", "context", "window", "problem"],
          "state_to_carry": ["research_problem"]
        },
        {
          "turn": 2,
          "query": "What are the three core hypotheses (H1, H2, H3) that ARD proposes? Explain each.",
          "expected_keywords": ["hypothesis", "H1", "H2", "H3", "state", "context", "workspace"],
          "state_to_carry": ["hypotheses"],
          "requires_previous_turn": true
        },
        {
          "turn": 3,
          "query": "For H2 (Context Window as Execution Workspace), what experimental evidence would convince you it's true?",
          "expected_keywords": ["experiment", "evidence", "token", "efficiency", "baseline", "compare"],
          "state_to_carry": ["experimental_design"],
          "requires_previous_turn": true
        },
        {
          "turn": 4,
          "query": "How does the transactional runtime (Transaction + MVCC) provide evidence for H1?",
          "expected_keywords": ["transaction", "MVCC", "H1", "state", "consistency", "rollback"],
          "state_to_carry": ["h1_evidence"],
          "requires_previous_turn": true
        },
        {
          "turn": 5,
          "query": "Design a complete experiment that would validate all three hypotheses simultaneously.",
          "expected_keywords": ["experiment", "design", "H1", "H2", "H3", "validate", "methodology"],
          "state_to_carry": ["experiment_design"],
          "requires_previous_turn": true
        }
      ]
    },
    {
      "scenario_id": "mt_003",
      "name": "System Evolution Decision Chain",
      "description": "5-turn evolving system design with conflicting requirements",
      "turns": [
        {
          "turn": 1,
          "query": "We need to add a new feature: real-time collaborative editing. How would you extend the ARD architecture?",
          "expected_keywords": ["collaborative", "extend", "architecture", "concurrent", "real-time"],
          "state_to_carry": ["feature_proposal", "architecture_extension"]
        },
        {
          "turn": 2,
          "query": "Wait, collaborative editing might cause too many transaction conflicts. What alternative approach could we use?",
          "expected_keywords": ["conflict", "alternative", "concurrent", "optimistic", "lock"],
          "state_to_carry": ["alternative_approach"],
          "requires_previous_turn": true
        },
        {
          "turn": 3,
          "query": "Actually, let's go back to the original proposal. Can we make collaborative editing work with MVCC snapshot isolation?",
          "expected_keywords": ["MVCC", "snapshot", "isolation", "collaborative", "original", "proposal"],
          "state_to_carry": ["revisited_proposal"],
          "requires_previous_turn": true
        },
        {
          "turn": 4,
          "query": "New constraint: we need to support mobile clients with intermittent connectivity. How does this change things?",
          "expected_keywords": ["mobile", "offline", "sync", "conflict", "resolution", "merge"],
          "state_to_carry": ["new_constraint"],
          "requires_previous_turn": true
        },
        {
          "turn": 5,
          "query": "Given all the decisions and reversals we've made, what is the final architecture? Trace the full decision chain.",
          "expected_keywords": ["final", "architecture", "decision", "chain", "trace", "version"],
          "state_to_carry": ["final_architecture", "decision_chain"],
          "requires_previous_turn": true
        }
      ]
    }
  ]
}
